NODE_ENV=production
PORT=4000
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>
BACKEND_PUBLIC_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
LOG_LEVEL=info

JWT_ACCESS_SECRET=<set-a-long-random-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_2FA_SECRET=<set-a-long-random-secret>
JWT_2FA_EXPIRES_IN=5m

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=<set-a-random-secret>

MEDIA_STORAGE_PROVIDER=s3
AWS_REGION=eu-west-1
AWS_S3_BUCKET=<bucket-name>
AWS_S3_PUBLIC_BASE_URL=https://cdn.example.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-pass>
SMTP_FROM=noreply@example.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_WRITE_MAX=200
RATE_LIMIT_WEBHOOK_MAX=600
RATE_LIMIT_OPS_MAX=60
OPS_DEAD_JOB_THRESHOLD=100
OPS_WORKER_POLL_MS=5000
OPS_WORKER_BATCH_SIZE=30
