NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://botchbuild:botchbuild@localhost:5432/botchbuild
BACKEND_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=debug
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_2FA_SECRET=change-me-2fa-secret-at-least-32-characters
JWT_2FA_EXPIRES_IN=5m
PAYMENT_WEBHOOK_SECRET=local-dev-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=paystack_dev_secret
MEDIA_STORAGE_PROVIDER=local
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_S3_PUBLIC_BASE_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@botchbuild.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=500
RATE_LIMIT_AUTH_MAX=40
RATE_LIMIT_WRITE_MAX=200
RATE_LIMIT_WEBHOOK_MAX=600
RATE_LIMIT_OPS_MAX=60
CACHE_ENABLED=true
CACHE_DEFAULT_TTL_MS=30000
CACHE_PROJECTS_TTL_MS=20000
CACHE_MAX_ENTRIES=5000
API_RESPONSE_BUDGET_BYTES=262144
OPS_DEAD_JOB_THRESHOLD=100
OPS_WORKER_POLL_MS=5000
OPS_WORKER_BATCH_SIZE=30
